{
  "name": "sistema-electoral/gestion-electoral",
  "type": "project",
  "description": "Sistema de gestión, digitación y resultados electorales",
  "require": {
    "php": "^8.3",
    "laravel/framework": "^13.0",
    "laravel/tinker": "^3.0"
  },
  "autoload": {"psr-4": {"App\\": "app/", "Database\\Seeders\\": "database/seeders/"}},
  "scripts": {
    "post-autoload-dump": ["@php artisan package:discover --ansi"]
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
